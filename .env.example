# Store deployment values in a protected .env file (0600).
POSTGRES_DB=tracker
POSTGRES_USER=tracker_owner
POSTGRES_PASSWORD=
MIGRATION_DATABASE_URL=postgresql+psycopg://tracker_owner:URL_ENCODED_OWNER_PASSWORD@db/tracker
DATABASE_URL=postgresql+psycopg://tracker_app:URL_ENCODED_APP_PASSWORD@db/tracker
APP_ENV=production
DEV_AUTH=0
DEV_NOTIFICATIONS=0
LDAP_URL=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_CA_FILE=/certs/ldap-ca.pem
LDAP_STARTTLS=0
LDAP_USERNAME_ATTRIBUTE=sAMAccountName
PUBLIC_URL=
SMTP_HOST=
SMTP_PORT=25
SMTP_TLS=starttls
SMTP_FROM=
SMTP_CA_FILE=
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFICATION_TIMEZONE=UTC
BACKUP_HOUR_UTC=2
BACKUP_RETENTION_DAYS=14
