# Copy to .env and set mode 0600. Replace the values marked CHANGE_ME.
# For a PostgreSQL server on the RHEL host use the Podman host gateway name.
POSTGRES_HOST=host.containers.internal
POSTGRES_PORT=5432
POSTGRES_DB=circuit_card_tracking
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_SSLMODE=prefer
POSTGRES_SSLROOTCERT=
DEV_AUTH=0
PUBLIC_URL=https://board-tracker.example.invalid:8443
TRACKER_HTTP_PORT=8080
TRACKER_HTTPS_PORT=8443
SMTP_HOST=
NOTIFICATION_TIMEZONE=UTC
