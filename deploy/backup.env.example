# systemd EnvironmentFile syntax. Use absolute host filesystem paths.
PGHOST=postgres.example.invalid
PGPORT=5432
PGDATABASE=circuit_card_tracking
PGUSER=CHANGE_ME
PGPASSFILE=/home/CHANGE_ME/.config/board-tracker/pgpass
PGSSLMODE=verify-full
# PGSSLROOTCERT=/home/CHANGE_ME/board-tracker/deploy/trust/postgres-ca.pem
PGCONNECT_TIMEOUT=10
BACKUP_DIR=/home/CHANGE_ME/.local/share/board-tracker/backups
BACKUP_STATUS_DIR=/home/CHANGE_ME/board-tracker/deploy/backup-status
BACKUP_RETENTION_DAYS=14
