[Unit]
Description=Board Tracker rootless Podman Compose stack

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/board-tracker
ExecStart=/usr/local/bin/podman-compose up -d
ExecStop=/usr/local/bin/podman-compose stop
TimeoutStartSec=180
TimeoutStopSec=120

[Install]
WantedBy=default.target
